# SolarIQ Environment Configuration
# Copy this file to .env and adjust values as needed.
# All values below show their defaults. Commented-out variables
# use the default if not set.

# ===========================================================================
# Environment
# ===========================================================================

# Application environment: development | testing | production
# SOLARIQ_ENV=development

# ===========================================================================
# Uvicorn / Server
# ===========================================================================

# Bind address (use 0.0.0.0 inside containers).
# SOLARIQ_HOST=127.0.0.1

# Port number.
# SOLARIQ_PORT=8000

# Number of worker processes (production only).
# Use 1 for development, 2*CPU+1 for production.
# SOLARIQ_WORKERS=1

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# SOLARIQ_LOG_LEVEL=INFO

# ===========================================================================
# CORS
# ===========================================================================

# Comma-separated list of allowed origins.
# Use * for development, restrict in production.
# SOLARIQ_CORS_ORIGINS=*

# ===========================================================================
# Database
# ===========================================================================

# SQLAlchemy connection URL.
# Default: sqlite:///solariq.db (file-based SQLite)
# For PostgreSQL: postgresql://user:password@host:5432/solariq
# SOLARIQ_DATABASE_URL=sqlite:///solariq.db

# Test database URL (in-memory SQLite by default).
# SOLARIQ_TEST_DATABASE_URL=sqlite://

# ===========================================================================
# Solar / BIPV Defaults
# ===========================================================================

# Fraction of roof area available for panels (0.0 - 1.0).
# SOLARIQ_COVERAGE_FACTOR=0.80

# Solar panel efficiency (0.0 - 1.0).
# SOLARIQ_PANEL_EFFICIENCY=0.20

# Annual solar irradiance in kWh/m² (varies by location).
# Typical range: 1000 - 2500 depending on geography.
# SOLARIQ_ANNUAL_IRRADIANCE=1700.0

# System performance ratio (accounts for inverter losses, wiring, etc.)
# Typical range: 0.75 - 0.90.
# SOLARIQ_PERFORMANCE_RATIO=0.85

# ===========================================================================
# Optimization Scoring Weights
# ===========================================================================
# These control how surfaces are ranked. Weights are normalized
# to sum to 1.0 at runtime.

# Weight for solar suitability score.
# SOLARIQ_OPT_WEIGHT_SUITABILITY=0.35

# Weight for annual energy potential.
# SOLARIQ_OPT_WEIGHT_ENERGY=0.25

# Weight for installed capacity (kW).
# SOLARIQ_OPT_WEIGHT_CAPACITY=0.15

# Weight for usable area (m²).
# SOLARIQ_OPT_WEIGHT_AREA=0.15

# Weight for surface orientation.
# SOLARIQ_OPT_WEIGHT_ORIENTATION=0.10

# ===========================================================================
# Request Limits
# ===========================================================================

# Maximum buildings per city-analysis request.
# SOLARIQ_MAX_BUILDINGS=100

# Maximum surfaces per building.
# SOLARIQ_MAX_SURFACES=50

# Maximum results returned by optimization endpoint.
# SOLARIQ_MAX_OPTIMIZATION_LIMIT=200

# ===========================================================================
# Model & Data Paths
# ===========================================================================

# Directory for ML model files (relative to project root).
# Must contain trusted model files only (see docs/MODEL_SECURITY.md).
# SOLARIQ_MODEL_DIR=models

# Root data directory.
# SOLARIQ_DATA_DIR=data

# Processed data output directory.
# SOLARIQ_PROCESSED_DATA_DIR=data/processed

# ===========================================================================
# External Geospatial & AI Services (Optional)
# ===========================================================================

# OpenStreetMap Overpass API interpreter endpoint
# SOLARIQ_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Open-Meteo Weather API endpoint
# SOLARIQ_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# AI Explanation Provider: standard | gemini | openai
# SOLARIQ_AI_PROVIDER=standard
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ===========================================================================
# Production Deployment
# ===========================================================================

# Frontend VITE_API_URL (set in frontend/.env or Render env vars)
# Leave empty for same-origin deployments (backend serves frontend).
# Set to backend URL for separate deployments:
#   VITE_API_URL=https://solariq-backend.onrender.com

# Render.com
# SERVICES: solariq-backend, solariq-frontend
# Render Dashboard: https://dashboard.render.com

# ===========================================================================
# Quick Deploy Commands
# ===========================================================================
#
# Local development:
#   docker compose up
#   (or) uvicorn backend.main:app --reload
#   (or) cd frontend && npm run dev
#
# Render deployment:
#   1. Push to GitHub
#   2. Connect repo on Render dashboard
#   3. Render reads render.yaml automatically
#   4. Set SOLARIQ_CORS_ORIGINS to your frontend URL
#   5. Set VITE_API_URL to your backend URL
#
# Docker production:
#   docker build -t solariq .
#   docker run -p 8000:8000 solariq

