# SolarIQ Frontend Environment Variables
#
# Copy this to .env in the frontend/ directory.
# Vite reads these at build time and embeds them in the JS bundle.
#
# VITE_API_URL
#   Leave empty for same-origin (backend serves frontend).
#   Set to the deployed backend URL for cross-origin deployments.
#
# Examples:
#   VITE_API_URL=                          # same-origin (default)
#   VITE_API_URL=https://solariq-backend.onrender.com
#   VITE_API_URL=http://localhost:8000      # explicit local
