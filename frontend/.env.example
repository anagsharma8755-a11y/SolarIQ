[TEMPLATE]
# SolarIQ Frontend Environment Variables
#
# Copy this to .env in the frontend/ directory.
# Vite reads these at build time and embeds them in the JS bundle.
#
# VITE_API_URL
#   Leave empty for same-origin (backend serves frontend).
#   Set to the deployed backend URL for cross-origin deployments.
#
# IMPORTANT: This must be set BEFORE building for production.
# After changing VITE_API_URL, trigger a redeploy on Cloudflare Pages.
#
# Examples:
#   VITE_API_URL=                          # same-origin (default, dev only)
#   VITE_API_URL=http://localhost:8080      # local backend
#   VITE_API_URL=https://your-backend.leapcell.app   # production
